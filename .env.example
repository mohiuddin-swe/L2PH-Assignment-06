NODE_ENV=development
PORT=5001

# Prisma Postgres direct connection string (postgres://..., not prisma+postgres://)
DATABASE_URL="postgres://USER:PASSWORD@db.prisma.io:5432/?sslmode=require"

# generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_DAYS=7
BCRYPT_ROUNDS=10

# comma separated list of allowed browser origins
CORS_ORIGINS=http://localhost:3000

# Google OAuth (optional until you set it up)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5001/api/v1/auth/google/callback

APP_BASE_URL=http://localhost:5001
SSLCOMMERZ_STORE_ID=tomar_store_id
SSLCOMMERZ_STORE_PASSWORD=tomar_store_password
SSLCOMMERZ_IS_LIVE=false

# Seed demo accounts (password: min 8 chars, letter + number)
SEED_ADMIN_EMAIL=admin@ums.test
SEED_ADMIN_PASSWORD=Admin@12345
SEED_TEACHER_EMAIL=teacher@ums.test
SEED_TEACHER_PASSWORD=Teacher@12345
SEED_STUDENT_EMAIL=student@ums.test
SEED_STUDENT_PASSWORD=Student@12345